# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APP_ID=000000000000000000

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/database_name?schema=public

# Gemini (kept in the environment; not stored in the database)
API_KEY=your_gemini_api_key_here

# AI provider administration
AI_ADMIN_USER_IDS=000000000000000000
# 32-byte key encoded as base64; replace this dummy value before use.
AI_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# HTTP server
PORT=3000

# Redeem-code channels
REDEEM_CHANNEL_GI=000000000000000000
REDEEM_CHANNEL_HSR=000000000000000000
REDEEM_CHANNEL_ZZZ=000000000000000000
TARGET_CHANNEL_ID=000000000000000000
TARGET_CHANNEL_ID2=000000000000000000
